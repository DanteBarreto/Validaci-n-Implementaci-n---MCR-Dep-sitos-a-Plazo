desg_0$Diferencial[mask] = desg_0$Desgaste[mask]
desg_0$Meses = ceiling(desg_0$Time/30.436875)
mask = desg_0$Meses<plazo
desg_0$Min = desg_0$Meses
desg_0$Min[!mask] = round(plazo)
desg_0$Ponderador = desg_0$Min*desg_0$Diferencial
desg_0$Supuesto_f = desg_0$Ponderador/sum(desg_0$Ponderador)
desg_0$plazo <- round(plazo)
desg_0$bank_type <- bank_type
desg_0$interest_type <- interest_type
# Concatenar la versión de desg_0 al dataframe principal
desgastes_df <- rbind(desgastes_df, desg_0)
arc = sum(desg_0$Supuesto_f * desg_0$Meses)
tab_mean3 = data.frame(cbind(arc, 'mean_f'))
colnames(tab_mean3) = c('value', 'stats')
tab_mean2 = rbind(tab_mean2, tab_mean3)
}
}
